# Terraform
infra/.terraform/
# infra/.terraform.lock.hcl is intentionally tracked: it pins provider versions
# (e.g. hashicorp/tls) so `terraform init` is reproducible across machines.
terraform.tfstate
terraform.tfstate.*
*.tfvars
!infra/terraform.tfvars.example
crash.log

# Interview prep material (panel names, personal strategy) must never live in the project repo --
# it is shared with interviewers. Kept in the parent directory instead.
study-pack.html
docs/study-pack.html
