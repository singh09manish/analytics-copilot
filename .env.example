# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
APP_MODEL=claude-sonnet-5

# Snowflake — account locator like ABC12345.us-east-1 (from Snowsight: Admin > Accounts)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=COPILOT_SVC
SNOWFLAKE_PRIVATE_KEY_PATH=secrets/copilot_svc_key.p8
SNOWFLAKE_WAREHOUSE=COPILOT_WH
SNOWFLAKE_DATABASE=MEDTECH_ANALYTICS
SNOWFLAKE_ROLE=COPILOT_APP_RO

# Auth (generate with: cd backend && uv run python ../scripts/gen_demo_users.py)
JWT_SECRET=dev-secret-change-me
DEMO_ANALYST_PASSWORD_HASH=
DEMO_ADMIN_PASSWORD_HASH=
USE_MCP=true

# Container deployments have no key file on disk, so the private key PEM arrives
# from Secrets Manager as this env var instead (see scripts/aws_bootstrap_secret.py).
# Leave blank for local dev -- SNOWFLAKE_PRIVATE_KEY_PATH above is used instead.
SNOWFLAKE_PRIVATE_KEY_PEM=

# Comma-separated allowed CORS origins. Same-origin behind CloudFront makes this
# moot in AWS; the default below is just for local frontend dev (`make web`).
CORS_ALLOW_ORIGINS=http://localhost:5173
